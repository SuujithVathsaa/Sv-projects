# ---- Gemini (required) ----
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Higgsfield (optional) ----
# Only needed if visuals.use_higgsfield is true in config/channel.yaml.
# The CLI stores its own auth after `higgsfield auth login`; this is a fallback.
HIGGSFIELD_API_KEY=

# ---- YouTube upload (required only for the publish stage) ----
# Path to the OAuth "Desktop app" client JSON from Google Cloud Console.
YOUTUBE_CLIENT_SECRET=client_secret.json
# Where the refresh token gets cached after scripts/auth_youtube.py runs.
YOUTUBE_TOKEN_FILE=token.json
